{
  "name": "@johnhenry/semantic-chunker",
  "version": "0.0.0",
  "description": "A tool for semantic chunking of text",
  "main": "index.mjs",
  "type": "module",
  "scripts": {
    "demo": "node demo.mjs",
    "demo:load": "node --env-file=.env.local demo.mjs",
    "test": "node --test test/unit/*.test.mjs",
    "test:integration": "node --env-file=.env.local --test test/integration/*.test.mjs",
    "typecheck": "tsc",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "exports": {
    ".": {
      "types": "./types/types.d.ts",
      "default": "./index.mjs"
    },
    "./embed/xenova": {
      "types": "./types/embed-xenova.d.ts",
      "default": "./embed/xenova.mjs"
    },
    "./embed/ollama": {
      "types": "./types/embed-ollama.d.ts",
      "default": "./embed/ollama.mjs"
    }
  },
  "files": [
    "index.mjs",
    "src/",
    "embed/",
    "types/",
    "readme.md",
    "LICENSE"
  ],
  "types": "types/types.d.ts",
  "keywords": [
    "semantic",
    "chunking",
    "chunker",
    "sentence",
    "nlp",
    "text-processing",
    "llm",
    "embedding"
  ],
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/semantic-chunker.git"
  },
  "dependencies": {
    "compromise": "^14.14.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^3.1.2",
    "@xenova/transformers": "^2.17.2",
    "ollama": "^0.5.8"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@xenova/transformers": {
      "optional": true
    },
    "ollama": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.1.2",
    "@types/node": "^26.1.1",
    "@xenova/transformers": "^2.17.2",
    "ollama": "^0.5.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "homepage": "https://opensource.johnhenry.me/semantic-chunker/"
}
